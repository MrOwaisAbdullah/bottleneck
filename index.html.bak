    <!-- Load external data file -->
    <script src="data.js"></script>

    <script>
        // Chart storage
        const charts = {};

        // DOM elements
        let cpuSelect, gpuSelect, gameSelect, toggleBtn, advancedFields, calculateBtn, resultsSection;

        // Populate dropdowns
        function populateDropdowns() {
            // Populate CPUs
            components.cpus.forEach(cpu => {
                const option = document.createElement('option');
                option.value = cpu.id;
                option.textContent = `${cpu.name} (Rank: ${cpu.rank})`;
                cpuSelect.appendChild(option);
            });

            // Populate GPUs
            components.gpus.forEach(gpu => {
                const option = document.createElement('option');
                option.value = gpu.id;
                option.textContent = `${gpu.name} (Rank: ${gpu.rank})`;
                gpuSelect.appendChild(option);
            });

            // Populate Games
            if (gameSelect) {
                components.games.forEach(game => {
                    const option = document.createElement('option');
                    option.value = game.id;
                    option.textContent = game.name;
                    gameSelect.appendChild(option);
                });
            }
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', function() {
            // Get DOM elements
            cpuSelect = document.getElementById('cpu');
            gpuSelect = document.getElementById('gpu');
            gameSelect = document.getElementById('game');
            toggleBtn = document.getElementById('advanced-toggle');
            advancedFields = document.getElementById('advanced-fields');
            calculateBtn = document.getElementById('calculate-btn');
            resultsSection = document.getElementById('results-section');

            // Populate dropdowns
            populateDropdowns();

            // Toggle advanced options
            toggleBtn.addEventListener('click', function() {
                if (advancedFields.style.display === 'none' || advancedFields.style.display === '') {
                    advancedFields.style.display = 'block';
                    toggleBtn.innerHTML = `
                        <span>Hide Advanced Options</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 15 12 9 18 15"></polyline>
                        </svg>
                    `;
                } else {
                    advancedFields.style.display = 'none';
                    toggleBtn.innerHTML = `
                        <span>Show Advanced Options</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    `;
                }
            });

            // Calculate bottleneck
            calculateBtn.addEventListener('click', function() {
                try {
                    console.log('Calculate button clicked');
                    
                    // Check if DOM elements exist
                    if (!cpuSelect) {
                        console.error('CPU select element not found');
                        alert('Error: CPU select element not found');
                        return;
                    }
                    
                    if (!gpuSelect) {
                        console.error('GPU select element not found');
                        alert('Error: GPU select element not found');
                        return;
                    }
                    
                    const cpuId = cpuSelect.value;
                    const gpuId = gpuSelect.value;
                    
                    console.log('Selected CPU ID:', cpuId);
                    console.log('Selected GPU ID:', gpuId);

                    if (!cpuId || !gpuId) {
                        console.warn('Please select both CPU and GPU to calculate bottleneck.');
                        alert('Please select both CPU and GPU to calculate bottleneck.');
                        return;
                    }

                    const cpu = components.cpus.find(c => c.id === cpuId);
                    const gpu = components.gpus.find(g => g.id === gpuId);
                    
                    console.log('Found CPU:', cpu);
                    console.log('Found GPU:', gpu);
                    
                    if (!cpu) {
                        console.error('CPU not found in components database');
                        alert('Error: Selected CPU not found in database');
                        return;
                    }
                    
                    if (!gpu) {
                        console.error('GPU not found in components database');
                        alert('Error: Selected GPU not found in database');
                        return;
                    }
                    
                    const resolutionElement = document.getElementById('resolution');
                    if (!resolutionElement) {
                        console.error('Resolution element not found');
                        alert('Error: Resolution element not found');
                        return;
                    }
                    
                    const resolution = resolutionElement.value;
                    console.log('Selected resolution:', resolution);

                    // Get advanced settings
                    const ramElement = document.getElementById('ram');
                    const purposeElement = document.getElementById('purpose');
                    const gameElement = document.getElementById('game');
                    const refreshRateElement = document.getElementById('refresh-rate');
                    const graphicsSettingsElement = document.getElementById('graphics-settings');
                    
                    if (!ramElement || !purposeElement || !gameElement || !refreshRateElement || !graphicsSettingsElement) {
                        console.error('Some advanced settings elements not found');
                        alert('Error: Some advanced settings elements not found');
                        return;
                    }
                    
                    const ram = parseInt(ramElement.value) || 16;
                    const purpose = purposeElement.value || "gaming";
                    const gameId = gameElement.value || "";
                    const refreshRate = parseInt(refreshRateElement.value) || 144;
                    const graphicsSettings = graphicsSettingsElement.value || "high";
                    
                    console.log('Advanced settings:', { ram, purpose, gameId, refreshRate, graphicsSettings });

                    // Perform calculation
                    console.log('Calling calculateBottleneck function');
                    const results = calculateBottleneck(cpu, gpu, resolution, {
                        ram, purpose, gameId, refreshRate, graphicsSettings
                    });
                    console.log('Calculation results:', results);

                    // Display results
                    console.log('Calling displayResults function');
                    displayResults(results, cpu, gpu, resolution);
                    console.log('Finished displaying results');
                } catch (error) {
                    console.error('Error calculating bottleneck:', error);
                    console.error('Error stack:', error.stack);
                    alert('An error occurred while calculating the bottleneck. Please check the console for details.');
                }
            });
        });

        // Bottleneck calculation
        function calculateBottleneck(cpu, gpu, resolution, advanced) {
            try {
                console.log('calculateBottleneck called with:', { cpu, gpu, resolution, advanced });
                
                // Validate inputs
                if (!cpu || !gpu) {
                    throw new Error('CPU or GPU is undefined');
                }
                
                if (!resolution) {
                    throw new Error('Resolution is undefined');
                }
                
                if (!advanced) {
                    throw new Error('Advanced settings are undefined');
                }
                
                if (!cpu.score || !gpu.score) {
                    throw new Error('CPU or GPU score is missing');
                }
                
                let cpuScore = cpu.score;
                let gpuScore = gpu.score;
                
                console.log('Initial scores - CPU:', cpuScore, 'GPU:', gpuScore);

                // Adjust for resolution
                const resolutionFactors = {
                    '1080p': { cpu: 1.0, gpu: 1.0 },
                    '1440p': { cpu: 0.92, gpu: 1.25 },
                    '4k': { cpu: 0.85, gpu: 1.6 }
                };
                
                if (!resolutionFactors[resolution]) {
                    console.warn('Invalid resolution:', resolution, 'Using default 1080p');
                    resolution = '1080p';
                }
                
                cpuScore *= resolutionFactors[resolution].cpu;
                gpuScore *= resolutionFactors[resolution].gpu;
                
                console.log('Scores after resolution adjustment - CPU:', cpuScore, 'GPU:', gpuScore);

                // Game-specific adjustments
                if (advanced.gameId) {
                    const game = components.games.find(g => g.id === advanced.gameId);
                    if (game) {
                        console.log('Applying game adjustments for:', game.name);
                        // CPU-intensive games reduce GPU bottleneck impact
                const avgFPS = Math.round(effectiveFps);
                const maxFPS = Math.round(avgFPS * 1.25);
                const onePercentLows = Math.round(avgFPS * 0.7);
                
                console.log('Final metrics - Avg FPS:', avgFPS, 'Max FPS:', maxFPS, '1% Lows:', onePercentLows);

                const results = {
                    cpuBottleneck: Math.max(0, Math.min(100, cpuBottleneck)),
                    gpuBottleneck: Math.max(0, Math.min(100, gpuBottleneck)),
                    avgFPS: Math.max(30, avgFPS),
                    maxFPS: Math.max(40, maxFPS),
                    onePercentLows: Math.max(25, onePercentLows),
                    targetFPS: targetFps,
                    cpuScore,
                    gpuScore
                };
                
                console.log('Returning results:', results);
                return results;
            } catch (error) {
                console.error('Error in calculateBottleneck:', error);
                console.error('Error stack:', error.stack);
                throw error; // Re-throw to be caught by the event listener
            }
        }

        // Display results
        function displayResults(results, cpu, gpu, resolution) {
            try {
                // Show results section
                resultsSection.style.display = 'block';

                // Update configuration summary
                const configSummary = document.getElementById('config-summary');
                if (configSummary) {
                    configSummary.innerHTML = `
                        <p><strong>Current Configuration:</strong></p>
                        <p>• <strong>CPU:</strong> ${cpu.name}</p>
                        <p>• <strong>GPU:</strong> ${gpu.name}</p>
                        <p>• <strong>Resolution:</strong> ${resolution.toUpperCase()}</p>
                        <p>• <strong>RAM:</strong> ${document.getElementById('ram').value}GB ${document.getElementById('ram-type').value.toUpperCase()}</p>
                        <p>• <strong>Storage:</strong> ${document.getElementById('storage').value.toUpperCase()} SSD</p>
                        <p>• <strong>Purpose:</strong> ${document.getElementById('purpose').value.charAt(0).toUpperCase() + document.getElementById('purpose').value.slice(1)}</p>
                    `;
                }

                // Get advanced settings for Phase 2 features
                const advancedSettings = {
                    ram: document.getElementById('ram').value,
                    ramType: document.getElementById('ram-type').value,
                    storage: document.getElementById('storage').value,
                    purpose: document.getElementById('purpose').value,
                    refreshRate: document.getElementById('refresh-rate').value,
                    gameId: document.getElementById('game').value,
                    graphicsSettings: document.getElementById('graphics-settings').value,
                    resolution: resolution
                };

                // Populate Bottleneck Severity Banner
                populateSeverityBanner(results, cpu, gpu, resolution);

                // Populate Balance Meter
                populateBalanceMeter(results, cpu, gpu);

                // Populate Component Analysis
                populateComponentAnalysis(cpu, gpu, resolution);

                // Populate System Configuration Analysis (Phase 2)
                populateSystemConfigAnalysis(cpu, gpu, advancedSettings);

                // Populate Gaming Experience Prediction (Phase 2)
                populateGamingPrediction(cpu, gpu, advancedSettings);

                // Populate Optimization Tips (Phase 2)
                populateOptimizationTips(cpu, gpu, results, advancedSettings);

                // Update performance metrics
                const avgFps = document.getElementById('avg-fps');
                const maxFps = document.getElementById('max-fps');
                const onePercentLows = document.getElementById('one-percent-lows');
                
                if (avgFps) avgFps.textContent = results.avgFPS;
                if (maxFps) maxFps.textContent = results.maxFPS;
                if (onePercentLows) onePercentLows.textContent = results.onePercentLows;

                // Update gauge center values
                const cpuCenterValue = document.getElementById('cpu-center-value');
                const gpuCenterValue = document.getElementById('gpu-center-value');
                
                if (cpuCenterValue) cpuCenterValue.textContent = `${results.cpuBottleneck}%`;
                if (gpuCenterValue) gpuCenterValue.textContent = `${results.gpuBottleneck}%`;
                
                // Create gauges
                createGauge('cpu-gauge', results.cpuBottleneck, 'CPU');
                createGauge('gpu-gauge', results.gpuBottleneck, 'GPU');

                // Update status text
                const cpuStatus = document.getElementById('cpu-status');
                const gpuStatus = document.getElementById('gpu-status');
                
                if (cpuStatus) cpuStatus.textContent = getStatusText(results.cpuBottleneck);
                if (gpuStatus) gpuStatus.textContent = getStatusText(results.gpuBottleneck);

                // Generate recommendations
                generateRecommendations(results, cpu, gpu);

                // Scroll to results
                resultsSection.scrollIntoView({ behavior: 'smooth' });
            } catch (error) {
                console.error('Error displaying results:', error);
                alert('An error occurred while displaying results. Please check the console for details.');
            }
        }

        // Create gauge chart
        function createGauge(canvasId, value, type) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) {
                console.error(`Canvas element with ID '${canvasId}' not found`);
                return;
            }

            // Destroy existing chart if it exists
            if (canvas.chart) {
                canvas.chart.destroy();
            }

            // Determine color based on value
            let color;
            if (value <= 10) {
                color = '#4CAF50'; // Green
            } else if (value <= 25) {
                color = '#FFB300'; // Yellow
            } else {
                color = '#E53935'; // Red
            }

            // Create new chart
            const ctx = canvas.getContext('2d');
            canvas.chart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [type, 'Remaining'],
                    datasets: [{
                        data: [value, 100 - value],
                        backgroundColor: [
                            color,
                            '#2f396a'
                        ],
                        borderColor: 'transparent',
                        cutout: '80%',
                        borderRadius: 14
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    rotation: -90,
                    circumference: 180,
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: false }
                    },
                    animation: {
                        animateRotate: true,
                        duration: 1200,
                        easing: 'easeOutCubic'
                    }
                }
            });
        }

        // Get status text
        function getStatusText(value) {
            if (value <= 10) return 'Well Balanced';
            if (value <= 25) return 'Mild Bottleneck';
            return 'Significant Bottleneck';
        }

        // Generate recommendations
        function generateRecommendations(results, cpu, gpu) {
            const container = document.getElementById('recommendations');
            let recommendations = [];

            // Bottleneck-specific recommendations
            if (results.cpuBottleneck > results.gpuBottleneck && results.cpuBottleneck > 15) {
                recommendations.push({
                    title: "CPU Bottleneck Detected",
                    detail: `Your CPU is bottlenecking your GPU by ${results.cpuBottleneck}%. Consider upgrading to a higher-tier processor for better performance.`
                });
            } else if (results.gpuBottleneck > results.cpuBottleneck && results.gpuBottleneck > 15) {
                recommendations.push({
                    title: "GPU Bottleneck Detected",
                    detail: `Your GPU is bottlenecking your CPU by ${results.gpuBottleneck}%. Consider upgrading to a more powerful graphics card to fully utilize your processor.`
                });
            } else {
                recommendations.push({
                    title: "Well-Balanced System",
                    detail: "Your system is well-balanced! Both CPU and GPU are working efficiently together."
                });
            }

            // FPS vs Refresh Rate recommendation
            const refreshRate = parseInt(document.getElementById('refresh-rate').value);
            if (results.avgFPS < refreshRate * 0.8) {
                recommendations.push({
                    title: "Low Frame Rate",
                    detail: `Your estimated ${results.avgFPS} FPS may not fully utilize your ${refreshRate}Hz monitor. Consider lowering graphics settings or upgrading components.`
                });
            }

            // RAM recommendation
            const ram = parseInt(document.getElementById('ram').value);
            if (ram < 16) {
                recommendations.push({
                    title: "Insufficient RAM",
                    detail: "Consider upgrading to 16GB RAM or more for better performance in modern games."
                });
            }

            // Resolution-specific recommendation
            const resolution = document.getElementById('resolution').value;
            if (resolution === '1080p' && results.gpuBottleneck > 25) {
                recommendations.push({
                    title: "Underutilized GPU",
                    detail: "At 1080p, your GPU is underutilized. Consider increasing your resolution to 1440p for better GPU utilization."
                });
            } else if (resolution === '4k' && results.cpuBottleneck > 25) {
                recommendations.push({
                    title: "CPU Bottleneck at 4K",
                    detail: "At 4K, your CPU is significantly bottlenecking your GPU. Consider lowering your resolution to 1440p for better CPU utilization."
                });
            }

            // Game-specific recommendations
            const gameId = document.getElementById('game').value;
            if (gameId) {
                const game = components.games.find(g => g.id === gameId);
                if (game && game.cpu_intensity > 0.8 && results.cpuBottleneck > 15) {
                    recommendations.push({
                        title: "CPU-Intensive Game",
                        detail: `The game "${game.name}" is particularly CPU-intensive. Consider lowering CPU-dependent settings like draw distance and population density.`
                    });
                }
                
                if (game && game.gpu_intensity > 0.8 && results.gpuBottleneck > 15) {
                    recommendations.push({
                        title: "GPU-Intensive Game",
                        detail: `The game "${game.name}" is particularly GPU-intensive. Consider lowering GPU-dependent settings like texture quality and anti-aliasing.`
                    });
                }
            }

            // Purpose-specific recommendations
            const purpose = document.getElementById('purpose').value;
            if (purpose === 'streaming' && results.cpuBottleneck > 15) {
                recommendations.push({
                    title: "Streaming Performance",
                    detail: "For streaming, a stronger CPU is recommended to handle both gaming and encoding simultaneously."
                });
            }

            // Generate HTML
            container.innerHTML = recommendations.map(rec => `
                <div class="recommendation-item">
                    <div class="recommendation-icon">•</div>
                    <div class="recommendation-content">
                        <span class="recommendation-title">${rec.title}</span>
                        <span class="recommendation-detail">${rec.detail}</span>
                    </div>
                </div>
            `).join('');
        }

        // Populate Severity Banner
        function populateSeverityBanner(results, cpu, gpu, resolution) {
            try {
                // Get DOM elements
                const severityBanner = document.getElementById('severity-banner');
                const severityValue = document.getElementById('severity-value');
                const severityTitle = document.getElementById('severity-title');
                const severityText = document.getElementById('severity-text');
                const severityResolution = document.getElementById('severity-resolution');
                
                // Check if all elements exist
                if (!severityBanner || !severityValue || !severityTitle || !severityText || !severityResolution) {
                    console.error('Severity banner elements not found');
                    return;
                }
                
                // Calculate overall bottleneck (higher of CPU or GPU bottleneck)
                const overallBottleneck = Math.max(results.cpuBottleneck, results.gpuBottleneck);
                
                // Determine severity level
                let severityClass = '';
                let severityTitleText = '';
                let severityDescription = '';
                
                if (overallBottleneck <= 10) {
                    severityClass = 'severity-low';
                    severityTitleText = 'Well Balanced System';
                    severityDescription = 'Your CPU and GPU are well-balanced with minimal bottlenecking. Both components are working efficiently together.';
                } else if (overallBottleneck <= 25) {
                    severityClass = 'severity-medium';
                    severityTitleText = 'Mild Bottleneck Detected';
                    severityDescription = 'There is a minor imbalance between your CPU and GPU that may slightly impact performance.';
                } else {
                    severityClass = 'severity-high';
                    if (results.cpuBottleneck > results.gpuBottleneck) {
                        severityTitleText = 'Significant CPU Bottleneck';
                        severityDescription = 'Your CPU is significantly limiting your GPU performance. Upgrading your processor would provide better overall system performance.';
                    } else {
                        severityTitleText = 'Significant GPU Bottleneck';
                        severityDescription = 'Your GPU is significantly limiting your CPU performance. Upgrading your graphics card would provide better gaming performance.';
                    }
                }
                
                // Update DOM elements
                severityBanner.className = `severity-banner ${severityClass}`;
                severityValue.textContent = `${overallBottleneck}%`;
                severityTitle.textContent = severityTitleText;
                severityText.textContent = severityDescription;
                severityResolution.textContent = `Current Resolution: ${resolution.toUpperCase()}`;
                
                // Show the banner
                severityBanner.style.display = 'block';
            } catch (error) {
                console.error('Error populating severity banner:', error);
            }
        }

        // Populate Balance Meter
        function populateBalanceMeter(results, cpu, gpu) {
            try {
                const balanceMeter = document.getElementById('balance-meter');
                const meterMarker = document.getElementById('meter-marker');
                
                // Check if all elements exist
                if (!balanceMeter || !meterMarker) {
                    console.error('Balance meter elements not found');
                    return;
                }
                
                // Calculate balance point based on CPU/GPU scores
                // Normalize to 0-100 scale where 50 is optimal balance
                let balancePosition = 50;
                
                if (cpu.score > gpu.score) {
                    // CPU dominant (left side of meter)
                    const ratio = cpu.score / gpu.score;
                    balancePosition = 50 - Math.min(50, (ratio - 1) * 25);
                } else if (gpu.score > cpu.score) {
                    // GPU dominant (right side of meter)
                    const ratio = gpu.score / cpu.score;
                    balancePosition = 50 + Math.min(50, (ratio - 1) * 25);
                }
                
                // Position the marker
                meterMarker.style.left = `${balancePosition}%`;
                
                // Show the meter
                balanceMeter.style.display = 'block';
            } catch (error) {
                console.error('Error populating balance meter:', error);
            }
        }

        // Populate Component Analysis
        function populateComponentAnalysis(cpu, gpu, resolution) {
            try {
                const componentAnalysis = document.getElementById('component-analysis');
                
                // Check if component analysis element exists
                if (!componentAnalysis) {
                    console.error('Component analysis element not found');
                    return;
                }
                
                // Populate CPU analysis
                const cpuModel = document.getElementById('cpu-model');
                const cpuRank = document.getElementById('cpu-rank');
                if (cpuModel) cpuModel.textContent = cpu.name;
                if (cpuRank) cpuRank.textContent = `Rank: #${cpu.rank}`;
                
                // CPU specs
                const cpuCores = document.getElementById('cpu-cores');
                const cpuBaseClock = document.getElementById('cpu-base-clock');
                const cpuBoostClock = document.getElementById('cpu-boost-clock');
                const cpuScore = document.getElementById('cpu-score');
                
                if (cpuCores || cpuBaseClock || cpuBoostClock || cpuScore) {
                    const coreCount = cpu.pCoreCount && cpu.eCoreCount ? 
                        `${cpu.pCoreCount}P+${cpu.eCoreCount}E` : 
                        `${cpu.coreCount || 'N/A'} Cores`;
                    if (cpuCores) cpuCores.textContent = `${coreCount} / ${cpu.threadCount || 'N/A'} Threads`;
                    if (cpuBaseClock) cpuBaseClock.textContent = cpu.baseClock || 'N/A';
                    if (cpuBoostClock) cpuBoostClock.textContent = cpu.boostClock || 'N/A';
                    if (cpuScore) cpuScore.textContent = cpu.score.toLocaleString();
                }
                
                // CPU assessment
                const cpuAssessment = document.getElementById('cpu-assessment');
                if (cpuAssessment) {
                    let assessment = '';
                    if (cpu.coreCount >= 8 && cpu.threadCount >= 16) {
                        assessment = 'Excellent for multitasking and CPU-intensive applications.';
                    } else if (cpu.coreCount >= 6 && cpu.threadCount >= 12) {
                        assessment = 'Good performance for gaming and general productivity.';
                    } else {
                        assessment = 'Suitable for basic tasks and light gaming.';
                    }
                    cpuAssessment.textContent = assessment;
                }
                
                // Populate GPU analysis
                const gpuModel = document.getElementById('gpu-model');
                const gpuRank = document.getElementById('gpu-rank');
                if (gpuModel) gpuModel.textContent = gpu.name;
                if (gpuRank) gpuRank.textContent = `Rank: #${gpu.rank}`;
                
                // GPU specs
                const gpuVram = document.getElementById('gpu-vram');
                const gpuBus = document.getElementById('gpu-bus');
                const gpuResolution = document.getElementById('gpu-resolution');
                const gpuScore = document.getElementById('gpu-score');
                
                if (gpuVram) gpuVram.textContent = gpu.vram || 'N/A';
                if (gpuBus) gpuBus.textContent = gpu.busInterface || 'N/A';
                
                // Resolution impact
                if (gpuResolution) {
                    const resolutionKey = resolution.replace('p', '');
                    const fps = gpu[`fps${resolutionKey}`] || 'N/A';
                    gpuResolution.textContent = `${resolution}: ${fps} FPS`;
                }
                
                if (gpuScore) gpuScore.textContent = gpu.score.toLocaleString();
                
                // GPU assessment
                const gpuAssessment = document.getElementById('gpu-assessment');
                if (gpuAssessment) {
                    let assessment = '';
                    if (gpu.score >= 30000) {
                        assessment = 'High-end graphics card capable of 4K gaming and VR applications.';
                    } else if (gpu.score >= 15000) {
                        assessment = 'Mid-range graphics card suitable for 1440p gaming.';
                    } else if (gpu.score >= 8000) {
                        assessment = 'Entry-level to mid-range graphics card suitable for 1080p gaming.';
                    } else {
                        assessment = 'Basic graphics capabilities for general use and light gaming.';
                    }
                    gpuAssessment.textContent = assessment;
                }
                
                // Show the analysis
                componentAnalysis.style.display = 'block';
            } catch (error) {
                console.error('Error populating component analysis:', error);
            }
        }

        // System Configuration Analysis Functions
        function analyzeRAM(ramAmount, ramType, purpose) {
            try {
                let status = 'good';
                let message = '';
                
                // Determine recommended RAM based on purpose
                let recommendedRAM = 16;
                switch (purpose) {
                    case 'video-editing':
                    case '3d-rendering':
                    case 'streaming':
                        recommendedRAM = 32;
                        break;
                    case 'gaming':
                        recommendedRAM = 16;
                        break;
                    case 'productivity':
                        recommendedRAM = 16;
                        break;
                }
                
                // Check RAM adequacy
                if (ramAmount < recommendedRAM) {
                    status = 'bad';
                    message = `Insufficient RAM for ${purpose}. Recommended: ${recommendedRAM}GB.`;
                } else if (ramAmount === recommendedRAM) {
                    status = 'good';
                    message = `Sufficient RAM for ${purpose}.`;
                } else {
                    status = 'good';
                    message = `More than sufficient RAM for ${purpose}.`;
                }
                
                // Factor in RAM type
                if (ramType === 'ddr5' && ramAmount >= 16) {
                    message += ' DDR5 provides better performance than DDR4.';
                } else if (ramType === 'ddr4' && ramAmount >= 32) {
                    message += ' Consider DDR5 for better performance with high RAM capacity.';
                }
                
                return {
                    status: status,
                    message: message,
                    amountType: `${ramAmount}GB ${ramType.toUpperCase()}`
                };
            } catch (error) {
                console.error('Error analyzing RAM:', error);
                return {
                    status: 'warning',
                    message: 'Unable to analyze RAM configuration.',
                    amountType: 'Unknown'
                };
            }
        }

        function analyzeStorage(storageType) {
            try {
                let status = 'good';
                let message = '';
                
                switch (storageType) {
                    case 'nvme':
                        status = 'good';
                        message = 'Excellent performance with fastest loading times.';
                        break;
                    case 'sata':
                        status = 'warning';
                        message = 'Good performance but slower than NVMe SSD.';
                        break;
                    case 'hdd':
                        status = 'bad';
                        message = 'Slow loading times. Consider upgrading to SSD.';
                        break;
                }
                
                // Capitalize first letter
                const displayType = storageType.charAt(0).toUpperCase() + storageType.slice(1);
                const storageName = displayType === 'Nvme' ? 'NVMe SSD' : 
                                  displayType === 'Sata' ? 'SATA SSD' : 
                                  'HDD';
                
                return {
                    status: status,
                    message: message,
                    type: storageName
                };
            } catch (error) {
                console.error('Error analyzing storage:', error);
                return {
                    status: 'warning',
                    message: 'Unable to analyze storage configuration.',
                    type: 'Unknown'
                };
            }
        }

        function analyzeUsageMatch(cpu, gpu, purpose) {
            try {
                let status = 'good';
                let message = '';
                
                // Define purpose requirements
                const purposeRequirements = {
                    'gaming': { cpu: 12000, gpu: 12000 },
                    'video-editing': { cpu: 16000, gpu: 10000 },
                    '3d-rendering': { cpu: 18000, gpu: 8000 },
                    'streaming': { cpu: 15000, gpu: 10000 },
                    'productivity': { cpu: 10000, gpu: 5000 }
                };
                
                const requirements = purposeRequirements[purpose] || purposeRequirements['gaming'];
                
                // Check if components meet requirements
                if (cpu.score < requirements.cpu * 0.8 || gpu.score < requirements.gpu * 0.8) {
                    status = 'bad';
                    message = `System underpowered for ${purpose}. Consider upgrading components.`;
                } else if (cpu.score < requirements.cpu * 0.95 || gpu.score < requirements.gpu * 0.95) {
                    status = 'warning';
                    message = `System slightly underpowered for ${purpose}. May experience limitations.`;
                } else {
                    status = 'good';
                    message = `Well-matched system for ${purpose}.`;
                }
                
                // Special case for gaming
                if (purpose === 'gaming') {
                    const balance = Math.abs(cpu.score - gpu.score) / ((cpu.score + gpu.score) / 2);
                    if (balance > 0.3) {
                        message += ' However, there is a significant imbalance between CPU and GPU.';
                    }
                }
                
                const purposeName = purpose.split('-').map(word => 
                    word.charAt(0).toUpperCase() + word.slice(1)
                ).join(' ');
                
                return {
                    status: status,
                    message: message,
                    purpose: purposeName
                };
            } catch (error) {
                console.error('Error analyzing usage match:', error);
                return {
                    status: 'warning',
                    message: 'Unable to analyze usage match.',
                    purpose: 'Unknown'
                };
            }
        }

        // Populate System Configuration Analysis
        function populateSystemConfigAnalysis(cpu, gpu, advancedSettings) {
            try {
                const systemConfigAnalysis = document.getElementById('system-config-analysis');
                
                if (!systemConfigAnalysis) {
                    console.error('System config analysis element not found');
                    return;
                }
                
                // Get advanced settings
                const ramAmount = parseInt(advancedSettings.ram) || 16;
                const ramType = advancedSettings.ramType || 'ddr4';
                const storageType = advancedSettings.storage || 'nvme';
                const purpose = advancedSettings.purpose || 'gaming';
                
                // Analyze RAM
                const ramAnalysis = analyzeRAM(ramAmount, ramType, purpose);
                const ramStatusIndicator = document.getElementById('ram-status-indicator');
                const ramAmountType = document.getElementById('ram-amount-type');
                const ramAnalysisText = document.getElementById('ram-analysis-text');
                
                if (ramStatusIndicator) {
                    ramStatusIndicator.textContent = ramAnalysis.status === 'good' ? '✓' : 
                                                    ramAnalysis.status === 'warning' ? '△' : '✗';
                    ramStatusIndicator.className = 'status-indicator ' + ramAnalysis.status;
                }
                if (ramAmountType) ramAmountType.textContent = ramAnalysis.amountType;
                if (ramAnalysisText) ramAnalysisText.textContent = ramAnalysis.message;
                
                // Analyze Storage
                const storageAnalysis = analyzeStorage(storageType);
                const storageStatusIndicator = document.getElementById('storage-status-indicator');
                const storageTypeElement = document.getElementById('storage-type');
                const storageAnalysisText = document.getElementById('storage-analysis-text');
                
                if (storageStatusIndicator) {
                    storageStatusIndicator.textContent = storageAnalysis.status === 'good' ? '✓' : 
                                                        storageAnalysis.status === 'warning' ? '△' : '✗';
                    storageStatusIndicator.className = 'status-indicator ' + storageAnalysis.status;
                }
                if (storageTypeElement) storageTypeElement.textContent = storageAnalysis.type;
                if (storageAnalysisText) storageAnalysisText.textContent = storageAnalysis.message;
                
                // Analyze Usage Match
                const usageAnalysis = analyzeUsageMatch(cpu, gpu, purpose);
                const usageStatusIndicator = document.getElementById('usage-status-indicator');
                const usagePurpose = document.getElementById('usage-purpose');
                const usageAnalysisText = document.getElementById('usage-analysis-text');
                
                if (usageStatusIndicator) {
                    usageStatusIndicator.textContent = usageAnalysis.status === 'good' ? '✓' : 
                                                      usageAnalysis.status === 'warning' ? '△' : '✗';
                    usageStatusIndicator.className = 'status-indicator ' + usageAnalysis.status;
                }
                if (usagePurpose) usagePurpose.textContent = usageAnalysis.purpose;
                if (usageAnalysisText) usageAnalysisText.textContent = usageAnalysis.message;
                
                // Show the analysis
                systemConfigAnalysis.style.display = 'block';
            } catch (error) {
                console.error('Error populating system config analysis:', error);
            }
        }

        // Gaming Experience Prediction Functions
        function predictEsportsPerformance(cpu, gpu, refreshRate) {
            try {
                // eSports games are more CPU-intensive for consistent frame rates
                const cpuFactor = Math.min(1.0, cpu.score / 15000); // Normalize to a high-end CPU
                const gpuFactor = Math.min(1.0, gpu.score / 12000); // Normalize to a mid-range GPU
                
                // Estimate FPS (eSports games typically need 100+ FPS for competitive play)
                let estimatedFPS = Math.round(100 * cpuFactor * 0.7 + 100 * gpuFactor * 0.3);
                
                // Adjust for refresh rate
                if (refreshRate >= 240) {
                    estimatedFPS = Math.min(estimatedFPS, 240);
                } else if (refreshRate >= 144) {
                    estimatedFPS = Math.min(estimatedFPS, 144);
                } else {
                    estimatedFPS = Math.min(estimatedFPS, 60);
                }
                
                // Performance description
                let performance = '';
                if (estimatedFPS >= refreshRate * 0.9) {
                    performance = 'Excellent performance for competitive gaming';
                } else if (estimatedFPS >= refreshRate * 0.7) {
                    performance = 'Good performance for competitive gaming';
                } else {
                    performance = 'May experience frame drops in competitive games';
                }
                
                // Settings recommendation
                let settings = 'High';
                if (estimatedFPS < 100) {
                    settings = 'Medium-High';
                } else if (estimatedFPS > 200) {
                    settings = 'Ultra';
                }
                
                return {
                    fps: estimatedFPS,
                    performance: performance,
                    settings: `${settings}, 1080p`
                };
            } catch (error) {
                console.error('Error predicting eSports performance:', error);
                return {
                    fps: 60,
                    performance: 'Unable to predict performance',
                    settings: 'Unknown'
                };
            }
        }

        function predictAAAPerformance(cpu, gpu, resolution) {
            try {
                // AAA games are more GPU-intensive
                const cpuFactor = Math.min(1.0, cpu.score / 15000);
                const gpuFactor = Math.min(1.0, gpu.score / 20000); // Normalize to a high-end GPU
                
                // Get resolution-specific FPS
                const resolutionKey = resolution.replace('p', '');
                const baseFPS = gpu[`fps${resolutionKey}`] || 60;
                
                // Estimate FPS with CPU limitation
                let estimatedFPS = Math.round(baseFPS * (gpuFactor * 0.7 + cpuFactor * 0.3));
                
                // Performance description
                let performance = '';
                if (estimatedFPS >= 60) {
                    performance = 'Great performance for demanding titles';
                } else if (estimatedFPS >= 30) {
                    performance = 'Playable performance for demanding titles';
                } else {
                    performance = 'Struggles with demanding titles';
                }
                
                // Settings recommendation
                let settings = 'Medium';
                if (resolution === '1080p' && estimatedFPS > 100) {
                    settings = 'High-Ultra';
                } else if (resolution === '1440p' && estimatedFPS > 60) {
                    settings = 'Medium-High';
                } else if (resolution === '4k' && estimatedFPS > 30) {
                    settings = 'Low-Medium';
                }
                
                return {
                    fps: estimatedFPS,
                    performance: performance,
                    settings: `${settings}, ${resolution}`
                };
            } catch (error) {
                console.error('Error predicting AAA performance:', error);
                return {
                    fps: 30,
                    performance: 'Unable to predict performance',
                    settings: 'Unknown'
                };
            }
        }

        function generateSettingsAdvice(cpu, gpu, resolution, gameId, graphicsSettings) {
            try {
                const advice = [];
                
                // Base advice on component strengths
                if (cpu.score > gpu.score * 1.2) {
                    advice.push('CPU is significantly stronger than GPU. Consider lowering CPU-intensive settings like draw distance and population density.');
                } else if (gpu.score > cpu.score * 1.2) {
                    advice.push('GPU is significantly stronger than CPU. Consider lowering GPU-intensive settings like texture quality and anti-aliasing.');
                }
                
                // Resolution-specific advice
                if (resolution === '4k' && gpu.score < 30000) {
                    advice.push('For 4K gaming, consider upgrading to a more powerful GPU.');
                } else if (resolution === '1080p' && gpu.score > 25000) {
                    advice.push('Your GPU is underutilized at 1080p. Consider increasing resolution to 1440p or 4K.');
                }
                
                // Game-specific advice
                if (gameId) {
                    const game = components.games.find(g => g.id === gameId);
                    if (game) {
                        if (game.cpu_intensity > 0.8 && cpu.score < 16000) {
                            advice.push(`"${game.name}" is CPU-intensive. Consider upgrading your CPU for better performance.`);
                        }
                        if (game.gpu_intensity > 0.8 && gpu.score < 15000) {
                            advice.push(`"${game.name}" is GPU-intensive. Consider upgrading your GPU for better performance.`);
                        }
                        if (game.ray_tracing_support && gpu.ray_tracing_multiplier < 1.0) {
                            advice.push(`"${game.name}" supports ray tracing. Your GPU has limited RT performance.`);
                        }
                    }
                }
                
                // Graphics settings advice
                switch (graphicsSettings) {
                    case 'ultra':
                    case 'rt-quality':
                        if (cpu.score < 15000 || gpu.score < 15000) {
                            advice.push('Ultra settings may be too demanding for your system. Consider Medium-High settings.');
                        }
                        break;
                    case 'low':
                    case 'medium':
                        if (cpu.score > 18000 && gpu.score > 20000) {
                            advice.push('Your system can handle higher settings. Consider High or Ultra settings for better visuals.');
                        }
                        break;
                }
                
                // Default advice if none added
                if (advice.length === 0) {
                    advice.push('Your system is well-balanced. Use High settings for a good balance of performance and visuals.');
                    advice.push('Texture Quality: High');
                    advice.push('Shadow Quality: Medium');
                    advice.push('Anti-Aliasing: FXAA');
                }
                
                return advice;
            } catch (error) {
                console.error('Error generating settings advice:', error);
                return ['Unable to generate settings advice.'];
            }
        }

        // Populate Gaming Experience Prediction
        function populateGamingPrediction(cpu, gpu, advancedSettings) {
            try {
                const gamingPrediction = document.getElementById('gaming-prediction');
                
                if (!gamingPrediction) {
                    console.error('Gaming prediction element not found');
                    return;
                }
                
                // Get advanced settings
                const resolution = advancedSettings.resolution || '1080p';
                const refreshRate = parseInt(advancedSettings.refreshRate) || 144;
                const gameId = advancedSettings.gameId || '';
                const graphicsSettings = advancedSettings.graphicsSettings || 'high';
                
                // Predict eSports performance
                const esportsPrediction = predictEsportsPerformance(cpu, gpu, refreshRate);
                const esportsFPS = document.getElementById('esports-fps');
                const esportsPerformance = document.getElementById('esports-performance');
                const esportsSettings = document.getElementById('esports-settings');
                
                if (esportsFPS) esportsFPS.textContent = `${esportsPrediction.fps} FPS`;
                if (esportsPerformance) esportsPerformance.textContent = esportsPrediction.performance;
                if (esportsSettings) esportsSettings.textContent = esportsPrediction.settings;
                
                // Predict AAA performance
                const aaaPrediction = predictAAAPerformance(cpu, gpu, resolution);
                const aaaFPS = document.getElementById('aaa-fps');
                const aaaPerformance = document.getElementById('aaa-performance');
                const aaaSettings = document.getElementById('aaa-settings');
                
                if (aaaFPS) aaaFPS.textContent = `${aaaPrediction.fps} FPS`;
                if (aaaPerformance) aaaPerformance.textContent = aaaPrediction.performance;
                if (aaaSettings) aaaSettings.textContent = aaaPrediction.settings;
                
                // Generate settings advice
                const adviceList = generateSettingsAdvice(cpu, gpu, resolution, gameId, graphicsSettings);
                const settingsAdviceList = document.getElementById('settings-advice-list');
                
                if (settingsAdviceList) {
                    settingsAdviceList.innerHTML = adviceList.map(advice => 
                        `<li>${advice}</li>`
                    ).join('');
                }
                
                // Show the prediction
                gamingPrediction.style.display = 'block';
            } catch (error) {
                console.error('Error populating gaming prediction:', error);
            }
        }

        // Optimization Tips Functions
        function generateSystemOptimizationTips(cpu, gpu, advancedSettings) {
            try {
                const tips = [];
                
                // RAM-related tips
                const ramAmount = parseInt(advancedSettings.ram) || 16;
                const ramType = advancedSettings.ramType || 'ddr4';
                
                if (ramAmount < 16) {
                    tips.push('Upgrade RAM to 16GB or more for better multitasking and gaming performance.');
                }
                
                if (ramType === 'ddr4' && cpu.ddr5_support) {
                    tips.push('Consider upgrading to DDR5 RAM for better performance with your CPU.');
                }
                
                // Storage-related tips
                const storageType = advancedSettings.storage || 'nvme';
                
                if (storageType === 'hdd') {
                    tips.push('Upgrade to an SSD for significantly faster loading times and system responsiveness.');
                } else if (storageType === 'sata') {
                    tips.push('Consider upgrading to NVMe SSD for even faster storage performance.');
                }
                
                // General system tips
                tips.push('Update GPU drivers to the latest version for optimal performance.');
                tips.push('Disable unnecessary startup programs to improve boot times.');
                tips.push('Enable Game Mode in Windows settings for better gaming performance.');
                tips.push('Keep your system clean and dust-free for optimal thermal performance.');
                
                return tips;
            } catch (error) {
                console.error('Error generating system optimization tips:', error);
                return ['Unable to generate optimization tips.'];
            }
        }

        function generateHardwareUpgradeSuggestions(cpu, gpu, results, advancedSettings) {
            try {
                const suggestions = [];
                
                // Identify primary bottleneck
                if (results.cpuBottleneck > results.gpuBottleneck && results.cpuBottleneck > 15) {
                    suggestions.push('CPU is significantly bottlenecking your GPU. Consider upgrading to a higher-tier processor.');
                } else if (results.gpuBottleneck > results.cpuBottleneck && results.gpuBottleneck > 15) {
                    suggestions.push('GPU is significantly bottlenecking your CPU. Consider upgrading to a more powerful graphics card.');
                }
                
                // Resolution-specific suggestions
                const resolution = advancedSettings.resolution || '1080p';
                
                if (resolution === '1080p' && results.gpuBottleneck < 10) {
                    suggestions.push('At 1080p, your GPU is underutilized. Consider increasing your resolution to 1440p.');
                } else if (resolution === '4k' && results.cpuBottleneck > 25) {
                    suggestions.push('At 4K, your CPU is significantly bottlenecking your GPU. Consider lowering your resolution to 1440p.');
                }
                
                // RAM suggestions
                const ramAmount = parseInt(advancedSettings.ram) || 16;
                const purpose = advancedSettings.purpose || 'gaming';
                
                if (purpose === 'video-editing' || purpose === '3d-rendering' || purpose === 'streaming') {
                    if (ramAmount < 32) {
                        suggestions.push('For content creation tasks, consider upgrading to 32GB or 64GB RAM.');
                    }
                }
                
                // Storage suggestions
                const storageType = advancedSettings.storage || 'nvme';
                
                if (storageType === 'hdd') {
                    suggestions.push('Upgrade to NVMe SSD for significantly faster loading times and system responsiveness.');
                }
                
                // Game-specific suggestions
                const gameId = advancedSettings.gameId || '';
                
                if (gameId) {
                    const game = components.games.find(g => g.id === gameId);
                    if (game) {
                        if (game.cpu_intensity > 0.8 && cpu.score < 16000) {
                            suggestions.push(`For "${game.name}", consider upgrading your CPU for better performance.`);
                        }
                        if (game.gpu_intensity > 0.8 && gpu.score < 15000) {
                            suggestions.push(`For "${game.name}", consider upgrading your GPU for better performance.`);
                        }
                    }
                }
                
                // Default suggestions if none added
                if (suggestions.length === 0) {
                    suggestions.push('Your system is well-balanced. No immediate upgrades necessary.');
                    suggestions.push('Consider increasing RAM to 32GB for content creation tasks.');
                    suggestions.push('Upgrade to faster NVMe SSD for improved storage performance.');
                }
                
                // Add general upgrade suggestions
                suggestions.push('Monitor component temperatures to ensure optimal performance and longevity.');
                suggestions.push('Consider a PC upgrade every 3-4 years for significant performance improvements.');
                
                return suggestions;
            } catch (error) {
                console.error('Error generating hardware upgrade suggestions:', error);
                return ['Unable to generate upgrade suggestions.'];
            }
        }

        // Populate Optimization Tips
        function populateOptimizationTips(cpu, gpu, results, advancedSettings) {
            try {
                const optimizationTips = document.getElementById('optimization-tips');
                
                if (!optimizationTips) {
                    console.error('Optimization tips element not found');
                    return;
                }
                
                // Generate system optimization tips
                const systemTips = generateSystemOptimizationTips(cpu, gpu, advancedSettings);
                const systemOptimizationList = document.getElementById('system-optimization-list');
                
                if (systemOptimizationList) {
                    systemOptimizationList.innerHTML = systemTips.map(tip => 
                        `<li>${tip}</li>`
                    ).join('');
                }
                
                // Generate hardware upgrade suggestions
                const upgradeSuggestions = generateHardwareUpgradeSuggestions(cpu, gpu, results, advancedSettings);
                const hardwareUpgradeList = document.getElementById('hardware-upgrade-list');
                
                if (hardwareUpgradeList) {
                    hardwareUpgradeList.innerHTML = upgradeSuggestions.map(suggestion => 
                        `<li>${suggestion}</li>`
                    ).join('');
                }
                
                // Show the tips
                optimizationTips.style.display = 'block';
            } catch (error) {
                console.error('Error populating optimization tips:', error);
            }
        }
        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', function() {
            populateDropdowns();
        });
    </script>
</body>
</html>